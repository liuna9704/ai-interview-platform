# ============================================================
# 环境变量示例
#
# 使用方法：复制本文件为 .env.local，再填入真实值
#     cp .env.example .env.local        (Windows: copy .env.example .env.local)
#
# .env.local 已在 .gitignore 中，不会被提交到仓库。
#
# ⚠️ 重要安全提醒（务必阅读）
#   Vue CLI 只会把 VUE_APP_ 开头的变量注入前端代码，而这些变量在
#   构建时会被**明文编译进 dist/js/*.js**，任何访问者都能读到。
#   所以把密钥放进环境变量，只解决了「不提交进 Git 仓库」，
#   并**不等于**安全。正式上线必须把讯飞签名逻辑迁移到服务端，
#   前端只调用自己的后端接口。
# ============================================================

# ---------- 后端 / Mock 服务基础地址 ----------
VUE_APP_API_BASE_URL=http://127.0.0.1:4523/m1/7900134-7650835-default

# ---------- 是否启用 Mock.js 请求拦截 ----------
# 取值 true / false
# 开发环境（npm run serve）默认 true
# 生产构建（npm run build）默认 false
VUE_APP_USE_MOCK=true

# ---------- 讯飞语音（TTS 语音合成 / IAT 语音听写）----------
# 控制台：https://console.xfyun.cn/
# 不配置时语音功能会自动禁用并给出提示，其余功能不受影响。
VUE_APP_XUNFEI_APPID=your_app_id
VUE_APP_XUNFEI_API_KEY=your_api_key
VUE_APP_XUNFEI_API_SECRET=your_api_secret
